<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

  <!--
    Generated VIM25 DTO classes (~4000 files in com.vmware.vim25 package).
    Auto-generated by yavijava_generator; not hand-maintained.
    Subpackages (mo/, ws/, mox/) ARE hand-written and are NOT excluded here.
  -->
  <Match>
    <Package name="com.vmware.vim25"/>
  </Match>

  <!--
    EI / EI2: "may expose internal representation by returning/storing mutable object"
    This library's API is fundamentally about sharing live vSphere objects
    (ManagedObjectReference, ServerConnection, ServiceInstance, VirtualMachine).
    Defensive copying would break the API contract and is not appropriate here.
  -->
  <Match>
    <Or>
      <Package name="~com\.vmware\.vim25\.mo.*"/>
      <Package name="~com\.vmware\.vim25\.ws.*"/>
      <Package name="~com\.vmware\.vim25\.mox.*"/>
      <Package name="~com\.vmware\.vim25\.util.*"/>
      <Package name="com.vmware.vim.cf"/>
    </Or>
    <Bug code="EI,EI2"/>
  </Match>

  <!--
    CT: "Exception thrown in constructor will leave object partially initialized"
    ServiceInstance, WSClient, and CommandLineParser constructors intentionally
    throw checked exceptions during vSphere API initialisation. The finalizer-
    attack risk is academic for a non-serialisable vSphere client library.
  -->
  <Match>
    <Or>
      <Class name="com.vmware.vim25.mo.ServiceInstance"/>
      <Class name="com.vmware.vim25.mo.util.CommandLineParser"/>
      <Class name="com.vmware.vim25.ws.WSClient"/>
    </Or>
    <Bug code="CT"/>
  </Match>

  <!--
    Nm: vSphere API uses PascalCase for some method names (e.g., HasPrivilegeOnEntity,
    QueryCmmds) to match the published VMware API specification. These cannot be renamed.
  -->
  <Match>
    <Package name="~com\.vmware\.vim25\.mo.*"/>
    <Bug code="Nm"/>
  </Match>

  <!--
    NP: Convenience overloads pass null for optional Boolean parameters.
    This is the correct way to omit optional vSphere API arguments (null = not set).
  -->
  <Match>
    <Or>
      <Class name="com.vmware.vim25.mo.DistributedVirtualSwitchManager"/>
      <Class name="com.vmware.vim25.mo.HostVsanInternalSystem"/>
      <Class name="com.vmware.vim25.mo.SearchIndex"/>
      <Class name="com.vmware.vim25.mo.VirtualDiskManager"/>
      <Class name="com.vmware.vim25.mo.VirtualMachine"/>
      <Class name="com.vmware.vim25.mo.VirtualMachineSnapshot"/>
      <Class name="com.vmware.vim25.mo.VsanUpgradeSystem"/>
      <Class name="com.vmware.vim25.mox.VirtualMachineDeviceManager"/>
    </Or>
    <Bug code="NP"/>
  </Match>

  <!--
    RCN: Redundant null check in ManagedObject.waitForValues — pre-existing style
    issue, not a correctness problem.
  -->
  <Match>
    <Class name="com.vmware.vim25.mo.ManagedObject"/>
    <Bug code="RCN"/>
  </Match>

  <!--
    mox.VirtualMachineDeviceManager: pre-existing code-style findings (dead store,
    useless object, integer-multiplication cast). These are non-critical and pre-date
    the 9.0 work; tracked for a future cleanup pass.
  -->
  <Match>
    <Class name="com.vmware.vim25.mox.VirtualMachineDeviceManager"/>
    <Or>
      <Bug code="DLS"/>
      <Bug code="ICAST"/>
      <Bug code="UC"/>
    </Or>
  </Match>

  <!--
    SBSC: String concatenation with + inside a loop in ReflectUtil.toByteArray.
    Pre-existing; a StringBuilder refactor is tracked separately.
  -->
  <Match>
    <Class name="org.doublecloud.ws.util.ReflectUtil"/>
    <Bug code="SBSC"/>
  </Match>

  <!--
    Dm: CommandLineParser reads user input from System.in (terminal).
    Using the platform-default charset is correct — it matches the terminal encoding.
  -->
  <Match>
    <Class name="com.vmware.vim25.mo.util.CommandLineParser"/>
    <Bug code="Dm"/>
  </Match>

  <!--
    MS: ClientCreator.clientClass is intentionally mutable. Tests and integrators
    swap in custom Client subclasses via this field; making it final would break
    that extensibility point.
  -->
  <Match>
    <Class name="com.vmware.vim25.ws.ClientCreator"/>
    <Bug code="MS"/>
  </Match>

  <!--
    PA: SoapClient fields are public by design. WSClient, ApacheHttpClient, and
    other subclasses access them directly; making them private would require
    changing the inheritance contract across all client implementations.
  -->
  <Match>
    <Class name="com.vmware.vim25.ws.SoapClient"/>
    <Bug code="PA"/>
  </Match>

  <!--
    DB: "same code for two branches" in SoapClient.setSoapActionOnApiVersion and
    PropertyCollectorUtil.convertProperty. These switch/if cases intentionally share
    a fallthrough result; the duplication is acceptable.
  -->
  <Match>
    <Or>
      <Class name="com.vmware.vim25.ws.SoapClient"/>
      <Class name="com.vmware.vim25.mo.util.PropertyCollectorUtil"/>
    </Or>
    <Bug code="DB"/>
  </Match>

  <!--
    NP: MorUtil.createExactManagedObject — possible null on the exception path for
    moClass. Pre-existing defensive pattern; tracked for a future cleanup.
  -->
  <Match>
    <Class name="com.vmware.vim25.mo.util.MorUtil"/>
    <Bug code="NP"/>
  </Match>

</FindBugsFilter>
